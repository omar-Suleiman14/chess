{
  "name": "chess",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "convex dev --start \"next dev\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "calibrate": "esbuild scripts/calibrate.ts --bundle --platform=node --format=esm --packages=external --outfile=.cache/calibrate.mjs --log-level=warning && node .cache/calibrate.mjs",
    "slice-fatma": "node scripts/slice-fatma.mjs"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@clerk/nextjs": "^6.39.6",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@modelcontextprotocol/server": "2.3.1",
    "blobatar": "2.7.0",
    "chess.js": "1.4.0",
    "convex": "^1.44.0",
    "html-to-image": "1.11.13",
    "idb": "8.0.4",
    "mcp-handler": "2.3.0",
    "motion": "14.3.0",
    "next": "^16.3.0",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stockfish": "19.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^5.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "convex-test": "^0.0.62",
    "esbuild": "0.27.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tailwindcss/oxide"
    ]
  }
}
